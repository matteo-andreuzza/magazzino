# Copia questo file in ".env" e cambia i valori prima del primo avvio.

# Utente amministratore creato al primo avvio.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiami-subito

# Nome mostrato in alto nell'app.
APP_NOME=Magazzino Sagra

# Porta del computer su cui si apre l'app (http://indirizzo-del-computer:8000).
PORTA=8000

# Password del database. Va decisa PRIMA del primo avvio: cambiarla dopo non ha effetto.
POSTGRES_PASSWORD=cambia-anche-questa

# Facoltativa: se vuota viene generata e conservata automaticamente.
DJANGO_SECRET_KEY=

# Backup su Google Drive (facoltativo, vedi README): cartella su Drive e per
# quanti giorni tenere lì le copie del database. Gli allegati non si cancellano.
DRIVE_CARTELLA=Backup magazzino sagra
DRIVE_GIORNI=30

# Solo per il debug (docker-compose.debug.yml): porta dell'app e stampa delle query.
PORTA_DEBUG=8002
DJANGO_LOG_SQL=0
