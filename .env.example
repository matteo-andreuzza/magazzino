# Copia questo file in ".env" e cambia i valori prima del primo avvio.

# Utente amministratore creato al primo avvio.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiami-subito

# Nome mostrato in alto nell'app.
APP_NOME=Magazzino Sagra

# Porta del computer su cui si apre l'app (http://indirizzo-del-computer:8000).
PORTA=8000

# Password del database. Va decisa PRIMA del primo avvio: cambiarla dopo non ha effetto.
POSTGRES_PASSWORD=cambia-anche-questa

# Facoltativa: se vuota viene generata e conservata automaticamente.
DJANGO_SECRET_KEY=

# Backup su Google Drive (facoltativo, vedi README): cartella su Drive e per
# quanti giorni tenere lì le copie del database. Gli allegati non si cancellano.
DRIVE_CARTELLA=Backup magazzino sagra
DRIVE_GIORNI=30

# Solo per il debug (docker-compose.debug.yml): porta dell'app e stampa delle query.
PORTA_DEBUG=8002
DJANGO_LOG_SQL=0

# Solo per l'installazione in cloud (docker-compose.cloud.yml): il dominio dell'app,
# che deve puntare all'indirizzo del server. Es. sagra.esempio.it
DOMINIO=

# Backup automatici in ./backup: ogni quanti minuti e per quanti giorni si tengono.
# BACKUP_OGNI_MINUTI=30
# BACKUP_GIORNI=10

# Copia remota (vedi docs/MANUTENZIONE.md, «Copia remota»): un altro server, es. il
# Raspberry di casa, tiene una copia di sola lettura della sagra.
# Sulla sagra e a casa la STESSA chiave, lunga e casuale:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# COPIA_CHIAVE=
# Solo sul server di casa: l'indirizzo della sagra (con Tailscale) e il servizio «copia».
# COPIA_DI=http://100.101.102.103:8000/
# COPIA_OGNI_MINUTI=5
# COMPOSE_PROFILES=copia
# Solo se l'app di casa è pubblicata con Tailscale Funnel (o un altro HTTPS davanti):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://raspberry.tuo-tailnet.ts.net
